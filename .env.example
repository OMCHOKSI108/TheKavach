# TheKavach Configuration
# Copy this file to .env and adjust values for your environment

# --- Hybrid Detector Thresholds ---
MODEL_HIGH_CONFIDENCE_THRESHOLD=0.85
MALICIOUS_OVERRIDE_THRESHOLD=0.70
SUSPICIOUS_OVERRIDE_THRESHOLD=0.55
ENABLE_RULE_BASED_FALLBACK=true

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# --- AI Model ---
HF_MODEL_ID=OMCHOKSI108/TheKavach

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
